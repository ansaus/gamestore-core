<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <!--
        Переменные задаются и через <env>, и через <server>.
        docker-compose пробрасывает те же имена в окружение процесса, а Laravel
        читает $_SERVER раньше $_ENV — без <server> тесты уехали бы на dev-базу.
    -->
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <server name="APP_ENV" value="testing"/>
        <!-- В тестах поднимаем и магазин, и заглушку: заглушку надо дёргать напрямую. -->
        <env name="APP_ROLE" value="all" force="true"/>
        <server name="APP_ROLE" value="all"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <server name="CACHE_STORE" value="array"/>
        <!--
            Только PostgreSQL: инварианты держатся на частичных индексах,
            jsonb, numeric и FOR UPDATE SKIP LOCKED. На sqlite это не проверить.
        -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <server name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="gamestore_test" force="true"/>
        <server name="DB_DATABASE" value="gamestore_test"/>
        <env name="DB_URL" value="" force="true"/>
        <server name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <server name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <!--
            Бэкофф между попытками к поставщику — реальный usleep. В тестах он
            только жжёт секунды: проверяем МЕХАНИКУ ретрая (тот же request_id,
            один ключ), а не длительность пауз.
        -->
        <env name="SUPPLIER_BACKOFF_MS" value="0" force="true"/>
        <server name="SUPPLIER_BACKOFF_MS" value="0"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <server name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>
