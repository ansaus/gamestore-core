APP_NAME=gamestore-core
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_ROLE=app

LOG_CHANNEL=stack
LOG_STACK=json
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=gamestore
DB_USERNAME=gamestore
DB_PASSWORD=secret

# Dedicated schema for the supplier stub (separate from the domain)
STUB_DB_SCHEMA=stub

QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_HOST=redis
REDIS_PORT=6379

# Адрес самого магазина изнутри сети Compose — для скриптов из /scripts
APP_INTERNAL_URL=http://nginx

# Supplier client (stage 3)
SUPPLIER_BASE_URL=http://nginx:90
SUPPLIER_CONNECT_TIMEOUT=1
SUPPLIER_TIMEOUT=2
SUPPLIER_MAX_ATTEMPTS=3
SUPPLIER_BACKOFF_MS=200
SUPPLIER_UNKNOWN_RETRY_DELAY=30
SUPPLIER_MAX_DELIVERY_CYCLES=5

# Сверка и фоновое доведение (stage 4)
RECONCILE_GRACE_SECONDS=60
RECONCILE_BATCH=100
RECONCILE_MAX_ATTEMPTS=20
RECONCILE_MAX_BACKOFF=600

# Журнал денежных движений: условная себестоимость выдачи, доля от суммы заказа
LEDGER_COGS_RATE=0.70

# Catalog cache (stage 5)
CATALOG_CACHE_TTL=8

# uid/gid хостового пользователя — чтобы bind-mount не зарастал root-файлами
UID=1000
GID=1000
